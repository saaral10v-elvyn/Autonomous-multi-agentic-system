POSTGRES_DB=forge
POSTGRES_USER=forge
POSTGRES_PASSWORD=forge
DATABASE_URL=postgresql+asyncpg://forge:forge@localhost:5432/forge
REDIS_URL=redis://localhost:6379/0
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
MASTER_KEY=
COOKIE_SECURE=false
APPROVAL_TTL_SECONDS=86400
SANDBOX_PROVIDER=docker
SANDBOX_IMAGE=forge-sandbox:latest
SANDBOX_CPU=1.0
SANDBOX_MEMORY_MB=1024
SANDBOX_PIDS_LIMIT=256
SANDBOX_DISK_MB=2048
SANDBOX_TTL_SECONDS=3600
SANDBOX_NETWORK_MODE=none
# Set to allowlisted to enable HTTPS-only outbound access through an isolated proxy.
SANDBOX_ALLOWLIST_HOSTS=["registry.npmjs.org","pypi.org","files.pythonhosted.org","github.com","api.github.com","codeload.github.com","raw.githubusercontent.com","objects.githubusercontent.com","release-assets.githubusercontent.com"]
SANDBOX_MAX_OUTPUT_BYTES=65536
